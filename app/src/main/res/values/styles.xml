<resources>
    <!-- Light (default, name kept for the manifest). -->
    <style name="AppTheme" parent="android:style/Theme.DeviceDefault.Light">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">@font/montserrat_regular</item>
        <item name="android:colorAccent">@color/title_accent</item>
        <item name="accentColor">@color/title_accent</item>
        <item name="subTextColor">@color/text_navy</item>
    </style>

    <!-- Dark: regular dark grey surfaces. -->
    <style name="AppTheme.Dark" parent="android:style/Theme.DeviceDefault">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">@font/montserrat_regular</item>
        <item name="android:colorAccent">@color/accent_on_dark</item>
        <item name="accentColor">@color/accent_on_dark</item>
        <item name="subTextColor">@color/subtext_on_dark</item>
    </style>

    <!-- AMOLED: pure black surfaces on top of dark. -->
    <style name="AppTheme.Amoled" parent="AppTheme.Dark">
        <item name="android:windowBackground">@color/amoled_black</item>
        <item name="android:statusBarColor">@color/amoled_black</item>
        <item name="android:navigationBarColor">@color/amoled_black</item>
    </style>
</resources>
