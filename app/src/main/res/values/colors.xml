<resources>
    <!-- Terminal-glass palette. Accents derive from the wallpaper at runtime
         (UiTheme), falling back to the RR icon lavender #B0B8F0. The static
         values below are the fallback scrim set. -->
    <color name="title_accent">#B0B8F0</color>
    <!-- Dark navy from the icon's outlines (#383850), 11.4:1 on white. -->
    <color name="text_navy">#383850</color>
    <color name="accent_on_dark">#B0B8F0</color>
    <color name="subtext_on_dark">#C3C6DE</color>
    <!-- Translucent page scrims: the wallpaper shows through (blurred on
         Android 12+). Cards are lighter overlays on top. -->
    <color name="page_light">#E8F2F3FA</color>
    <color name="card_light">#8CFFFFFF</color>
    <color name="page_dark">#D914151C</color>
    <color name="card_dark">#1FFFFFFF</color>
</resources>
